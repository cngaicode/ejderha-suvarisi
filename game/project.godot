; Ejderha Süvarisi - Alp Vadisi v1.2
config_version=5

[application]

config/name="Ejderha Süvarisi"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
config/version="1.2"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

rendering_device/driver.ios="metal"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.55, 0.7, 0.9, 1)
anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=4
global_illumination/sdfgi/probe_ray_count=2
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
